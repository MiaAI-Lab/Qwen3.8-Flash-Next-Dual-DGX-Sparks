# ============================================================================
# Qwen3.8-Flash-Next-NVFP4 — vLLM Multi-Node Config (DGX Spark)
# ============================================================================
# Based on: https://github.com/getrefined/Qwen3.8-Flash-Next-NVFP4-vLLM-DGX-Spark
# Copy to .env and adjust for your cluster.

# -- Cluster Networking -------------------------------------------------------
HEAD_IP="10.0.0.1"
WORKER_IP="10.0.0.2"
WORKER_USER=""                          # SSH user on worker (blank = same as head)

# -- Network Interface ---------------------------------------------------------
# Run: ip -o -4 addr | grep <subnet>   to find your interface name.
# ConnectX ports on DGX Spark often use np0/np1 suffixes (e.g. enp1s0f0np0).
IFACE="enp1s0f0np0"                     # Inter-node ethernet interface

# -- InfiniBand ----------------------------------------------------------------
# Exact-match single device for NCCL. NEVER list a port cabled to another cluster.
# Run: ibstat | grep "Port "           to find your HCA device name.
IB_HCA="=rocep1s0f0"                   # Single device, exact match (leading =)
IB_GID_INDEX=3                          # Usually 3 on ConnectX with RoCE

# -- Model ---------------------------------------------------------------------
# THE RECIPE SWITCH — one line selects the checkpoint. Compatible builds:
#   "RadixArk/Qwen3.8-Flash-Next-NVFP4"   (default) — the build this recipe targets
#   "lychee888/Qwen3.8-Flash-Next-Uncensored-NVFP4-FP8PLE"
#       — orca's abliterated build with the PLE n-gram table FP8-quantized
#         (RadixArk-compatible PLE layout; 123.25 GiB; public).
#   "orcarouter/Qwen3.8-Flash-Next-Uncensored-NVFP4"
#       — orca's abliterated build, PLE kept bf16 (170.93 GiB; GATED: request
#         access at huggingface.co and set HF_TOKEN below).
#   "/absolute/path/to/model/dir" — local flat repo dir staged on both nodes
#       (skips HF download + worker rsync; bind-mounted read-only). The path
#       must resolve on both nodes (shared/NFS or identical staging).
MODEL_ID="RadixArk/Qwen3.8-Flash-Next-NVFP4"
SERVED_MODEL_NAME="qwen3.8-flash-next"          # for the orca-derived builds use "qwen3.8-flash-next-uncensored"

# -- PLE quant override (optional) ---------------------------------------------
# start.sh auto-derives this from the model's config.json
# (text_config.ple_embedding_dtype: float8_e4m3fn -> fp8, absent/bf16 -> bf16).
# Set explicitly only to override the auto-detection.
# PLE_QUANT_OVERRIDE="fp8"

# -- Serving Parameters --------------------------------------------------------
MAX_MODEL_LEN=1000000                    # YaRN 1M context
YARN_ENABLE=true                         # Extend context to ~1M tokens via YaRN rope scaling
                                          # (auto-disabled by start.sh when MAX_MODEL_LEN <= 262144)
YARN_FACTOR=4.0                          # 262K × 4.0 = ~1M tokens
GPU_MEMORY_UTILIZATION=0.835                # measured default for this kit — see README "KV cache budget"
                                            # measured: 0.835 -> 35.11 GiB KV / 2,481,424 tokens / 2.48x @1M
                                            # +0.01 GMU ≈ +0.83 GiB ≈ +61k cache tokens; raise only with headroom
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
PORT=8888
KV_CACHE_DTYPE=auto                # auto = model dtype = bf16 (tested on this kit)
                                   # fp8 ≈ 1.8× more cache tokens but unverified with the
                                   # QSA/GDN hybrid cache path here — see README "KV cache budget"

# -- Parallelism ---------------------------------------------------------------
TENSOR_PARALLEL_SIZE=2                  # 1 GPU per Spark × 2 nodes
ENABLE_EXPERT_PARALLEL=true             # Required for NVFP4

# -- MTP Speculative Decoding --------------------------------------------------
MTP_NUM_SPECULATIVE_TOKENS=3            # Set to 0 to disable

# -- Docker Image --------------------------------------------------------------
IMAGE="vllm/vllm-openai:qwen38-flash-next"

# -- PLE N-gram Embedding Offload ---------------------------------------------
PLE_OFFLOAD=false                       # Set true to offload 51B PLE table to CPU RAM

# -- HuggingFace cache --------------------------------------------------------
# Defaults to ~/.cache/huggingface on the head. The worker uses the same
# absolute path unless it lives under $HOME (then the prefix is rewritten to
# the worker's $HOME). Set WORKER_HF_HOME only if the worker cache differs.
# HF_HOME="/data/hf"
# WORKER_HF_HOME="/data/hf"

# -- Advanced ------------------------------------------------------------------
# EXTRA_VLLM_ARGS=""
# EXTRA_DOCKER_ARGS=""
# HF_TOKEN=""                            # needed only for gated repos (e.g. the orcarouter builds)
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1         # Required when MAX_MODEL_LEN > 262144 (YaRN)
MASTER_PORT=50000                       # NCCL/distributed coordination port
