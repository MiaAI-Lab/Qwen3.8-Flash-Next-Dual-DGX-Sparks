# ============================================================================
# Qwen3.8-Flash-Next-NVFP4 — vLLM Multi-Node Config (DGX Spark)
# ============================================================================
# Based on: https://github.com/getrefined/Qwen3.8-Flash-Next-NVFP4-vLLM-DGX-Spark
# Copy to .env and adjust for your cluster.

# -- Cluster Networking -------------------------------------------------------
HEAD_IP="10.0.0.1"
WORKER_IP="10.0.0.2"
WORKER_USER=""                          # SSH user on worker (blank = same as head)

# -- Network Interface ---------------------------------------------------------
# Run: ip -o -4 addr | grep <subnet>   to find your interface name.
# ConnectX ports on DGX Spark often use np0/np1 suffixes (e.g. enp1s0f0np0).
IFACE="enp1s0f0np0"                     # Inter-node ethernet interface

# -- InfiniBand ----------------------------------------------------------------
# Exact-match single device for NCCL. NEVER list a port cabled to another cluster.
# Run: ibstat | grep "Port "           to find your HCA device name.
IB_HCA="=rocep1s0f0"                   # Single device, exact match (leading =)
IB_GID_INDEX=3                          # Usually 3 on ConnectX with RoCE

# -- Model ---------------------------------------------------------------------
MODEL_ID="nvidia/Qwen3.8-Flash-Next-NVFP4"    # 133G / 11 shards: BF16 dense + NVFP4 experts + FP8 PLE
# MODEL_ID="local-inference-lab/Qwen3.8-Flash-Next-NVFP4"  # 99G / 37 shards: MXFP8 attention + NVFP4 PLE
# MODEL_ID="RadixArk/Qwen3.8-Flash-Next-NVFP4"             # 126G / 206 shards: BF16 attention + FP8 PLE
#
# PLE table format. The patched ple_layer.py dispatches on
# text_config.ple_embedding_dtype; nvidia/... declares its FP8 PLE only inside
# quantization_config.config_groups, so start.sh recovers the value with
# files/detect_ple_dtype.py and re-injects it via --hf-overrides. Set this only
# to override that detection.
# PLE_EMBEDDING_DTYPE=""
SERVED_MODEL_NAME="qwen3.8-flash-next"

# -- Serving Parameters --------------------------------------------------------
MAX_MODEL_LEN=262144                     # native context; raise + YARN_ENABLE=true for ~1M
YARN_ENABLE=false                        # Extend context to ~1M tokens via YaRN rope scaling
                                          # (auto-disabled by start.sh when MAX_MODEL_LEN <= 262144)
                                          # NOTE: before Sep 2026 this override was emitted at the
                                          # top level of --hf-overrides, where it never reached
                                          # text_config -- YaRN was a silent no-op. Now fixed, so
                                          # enabling it genuinely changes rope for the first time.
YARN_FACTOR=4.0                          # 262K × 4.0 = ~1M tokens
GPU_MEMORY_UTILIZATION=0.835                # measured default for this kit — see README "KV cache budget"
                                            # measured: 0.835 -> 32.02 GiB KV / 3,652,200 tokens / 13.93x @262K
                                            #           (fp8 KV; bf16 gives 2,131,159 / 8.13x)
                                            # +0.01 GMU ≈ +0.83 GiB ≈ +95k fp8 cache tokens; raise only with headroom
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
PORT=8888
KV_CACHE_DTYPE=fp8                 # DEFAULT. 3,652,200 cache tokens (13.93× at 262K) vs
                                   # 2,131,159 (8.13×) on bf16 — 1.70× per GiB. The stock QSA
                                   # kernels refuse fp8; start.sh applies files/patch_qsa_fp8_kv.py
                                   # automatically when this is set to fp8*.
                                   # Measured on this kit: no reasoning or needle regression
                                   # (12/12 both), no decode cost. Still a quality trade in
                                   # principle — quantised keys change which blocks the sparse
                                   # indexer picks, not just the attention output, so re-validate
                                   # on your own workload with bench/reasoning_check.py.
                                   # Set to `auto` for bf16. See README "KV cache budget"

# -- Parallelism ---------------------------------------------------------------
TENSOR_PARALLEL_SIZE=2                  # 1 GPU per Spark × 2 nodes
ENABLE_EXPERT_PARALLEL=true             # Required for NVFP4

# -- Multimodal (vision encoder) ---------------------------------------------
# NVFP4 kernels require input features divisible by 16. Vision MLP intermediate
# size is 4304, which is not after TP=2 (4304/2=2152). Use "data" (default) to
# replicate the encoder on each GPU; "weights" shards it and crashes at load time.
MM_ENCODER_TP_MODE=data

# -- MTP Speculative Decoding --------------------------------------------------
MTP_NUM_SPECULATIVE_TOKENS=3            # Set to 0 to disable

# -- Docker Image --------------------------------------------------------------
IMAGE="vllm/vllm-openai:qwen38-flash-next"

# -- PLE N-gram Embedding Offload ---------------------------------------------
PLE_OFFLOAD=false                       # Set true to offload 51B PLE table to CPU RAM

# -- HuggingFace cache --------------------------------------------------------
# Defaults to ~/.cache/huggingface on the head. The worker uses the same
# absolute path unless it lives under $HOME (then the prefix is rewritten to
# the worker's $HOME). Set WORKER_HF_HOME only if the worker cache differs.
# HF_HOME="/data/hf"
# WORKER_HF_HOME="/data/hf"

# -- Reduced-vocabulary MTP drafting -------------------------------------------
# The MTP drafter carries its OWN full 248,320-row BF16 lm_head (1.18 GiB, 0.59
# GiB/GPU at TP=2) and reads it once per draft step -- three of the four lm_head
# reads in an MTP=3 engine step. Pointing this at a frequency-ranked token-id
# list slices that head down for drafting only. Output-safe: drafts outside the
# subset are rejected at verification, never emitted; the cost is acceptance.
#   python3 bench/gen_draft_corpus.py --out corpus.jsonl        # model's own output
#   python3 files/build_draft_vocab.py corpus.jsonl --out draft_vocab.txt --size 32768
# MTP_DRAFT_VOCAB="/path/to/draft_vocab.txt"

# -- Decode-bandwidth experiments (see docs/CLAUDE/fable5-1-report.md) ----------
# FP8-dense hybrid checkpoint: NVFP4 routed experts + FP8 per-channel dense
# projections (GDN/attention/HC/shared-expert/lm_head). Build it once with
#   files/fp8dense/build.sh
# then flip this on. start.sh switches MODEL_ID to FP8_DENSE_MODEL_ID and
# bind-mounts the loader patches in files/overlay (no image rebuild).
FP8_DENSE=false
# FP8_DENSE_MODEL_ID="MiaAI-Lab/Qwen3.8-Flash-Next-NVFP4-FP8dense"
# QSA Triton launch profile for the 12 sparse-attention layers:
#   stock = image defaults (tuned on GB300, 160 SMs)
#   gb10  = 48-SM table in files/qsa_gb10/qsa.py (opt-in until benchmarked)
#   /path/to/profile.json = output of files/qsa_gb10/bench_qsa_kernels.py
QSA_PROFILE=stock
# Abort the launch if another process holds a GPU on either node.
REQUIRE_IDLE_GPU=true

# -- Advanced ------------------------------------------------------------------
# EXTRA_VLLM_ARGS=""
# EXTRA_DOCKER_ARGS=""
# HF_TOKEN=""
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1         # Required when MAX_MODEL_LEN > 262144 (YaRN)
MASTER_PORT=50000                       # NCCL/distributed coordination port

# -- Weight distribution ------------------------------------------------------
# false (default): each node keeps its own copy in ~/.cache/huggingface. start.sh
#   rsyncs the checkpoint to the worker once (skipped when already present).
# true: the head exports its HF cache over NFS on IFACE and the worker mounts it
#   read-only — no worker copy, no rsync wait, but the head must stay up and the
#   worker streams every shard over ConnectX on each cold start. Optional; see
#   "NFS weight sharing (optional)" in the README. Override per run: --nfs / --no-nfs.
NFS_SHARE=false
# NFS server address (only used when NFS_SHARE=true).
# Leave unset to auto-detect from IFACE (this box: 10.0.22.1).
# NFS_SERVER_IP="10.0.22.1"
