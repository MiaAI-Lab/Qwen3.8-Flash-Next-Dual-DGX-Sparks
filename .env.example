# =============================================================================
#  .env.example — copy to .env and edit.
#  Lines starting with # are ignored. Put comments on their OWN line; the
#  loader does not strip inline # from values. Shell env wins over .env, so
#  you can also override any of these inline (e.g. PORT=9999 ./start.sh serve).
#  Full variable list + notes in the start.sh header (./start.sh --help).
# =============================================================================

# ---- Cluster / networking ---------------------------------------------------
# These two are the RoCE link IPs used for the 2-node rendezvous and the NCCL
# rail. Match the IPs on your direct CX7 cable (no switch).
HEAD_CX7_IP=10.0.22.1
WORKER_CX7_IP=10.0.22.2

# Per-node CX7 interface and InfiniBand HCA names (only change if your Sparks
# wire the RoCE port differently).
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f0

# ---- Worker SSH target ------------------------------------------------------
# Most setups use the SAME user on both nodes. Leave WORKER_USER empty to reuse
# the head login user (ssh's own default). Set WORKER_HOST to the worker's
# hostname/IP, OR keep the alias "spark2" if you have a ~/.ssh/config entry.
# WORKER_SSH (in user@host form) overrides both if you need full control.
WORKER_USER=
WORKER_HOST=spark2
# WORKER_SSH=user@worker-host

# ---- API / ports ------------------------------------------------------------
PORT=8888

# Optional API key. When set, the server requires "Authorization: Bearer <key>"
# on every request, and start.sh's own readiness/status/smoke checks send it
# automatically. Leave empty for an open (LAN-trusted) server.
API_KEY=
HOST_BIND=0.0.0.0
DIST_PORT=26400

# ---- Serving recipe (GB10 / SM121 defaults) ---------------------------------
# GB10 unified DRAM: the ~26 GB/rank PLE table is INSIDE --mem-fraction-static
# (issue #8). 0.70 double-counted it and starved KV/mamba. 0.80 is the native
# 262k default. The 900k YaRN recipe uses 0.82 + CHUNKED_PREFILL_SIZE=1024.
MEM_FRACTION_STATIC=0.80
CONTEXT_LENGTH=262144
CHUNKED_PREFILL_SIZE=4096
MAX_RUNNING_REQUESTS=28
# 0 = over-length prompts 400; 1 = --allow-auto-truncate (silent trim).
ALLOW_AUTO_TRUNCATE=0

# NEXTN speculative decoding chain (draft = steps + 1, topk must be 1).
SPEC_STEPS=3
SPEC_TOPK=1
SPEC_DRAFT=4

# PLE n-gram table placement: empty = auto-rule (offload; recommended on GB10).
# 1 = --ple-offload-embedding, 0 = GPU-resident (needs a lower mem-fraction).
PLE_OFFLOAD=

# Mamba radix cache (must stay extra_buffer*: page 64 is pinned for compressed QSA).
MAMBA_RADIX_CACHE_STRATEGY=extra_buffer
MAMBA_TRACK_INTERVAL=64
MAMBA_FULL_MEMORY_RATIO=

# Decode CUDA graphs (default list is tuned so the graph pool doesn't OOM on GB10).
ENABLE_DECODE_GRAPHS=1
CUDA_GRAPH_BS=1 2 3 4 5 6 7 8 10 12 14 16

# Attention / GEMM backends — empty = auto (proven-on-SM121 defaults).
ATTENTION_BACKEND=flashinfer
# NVFP4 KV cache (default on): 1 = store the QSA layers' KV as NVFP4 FP4 +
# per-block FP8 scales (the SM121 kernel work in this repo's patched image;
# QSA gathers then dequantizes to bf16). Measured 2,902,208 tokens (~3.1x vs
# bf16) at FP4 KV accuracy; 11/11 NIAH PASS through 16k. 0 = bf16 KV.
NVFP4_KV_CACHE=1
# Raw --kv-cache-dtype override (e.g. fp8_e4m3, untested here). Must be empty
# when NVFP4_KV_CACHE=1.
KV_CACHE_DTYPE=
FP4_GEMM_BACKEND=
LINEAR_ATTN_PREFILL_BACKEND=
LINEAR_ATTN_DECODE_BACKEND=

# ---- Model / image ----------------------------------------------------------
SERVED_MODEL_NAME=Qwen3.8-Flash-Next-NVFP4
KERNEL_PATCH=1
BASE_IMAGE=lmsysorg/sglang:qwen38flashnext
PATCHED_IMAGE=qwen38-flashnext-dspark:local
# IMAGE=         # set to use a specific image verbatim (skip the patch build)

# ---- Ops ---------------------------------------------------------------------
# rsync = head pulls from HF, then rsyncs to worker (one internet download).
# direct = worker pulls from HF itself.
DOWNLOAD_MODE=rsync
USE_HOST_NCCL=1
WAIT_TIMEOUT_MIN=90
NCCL_DEBUG=WARN
NCCL_CROSS_NIC=0
CPUSET=5-9,15-19
REASONING_PARSER=auto
TOOL_CALL_PARSER=auto

# ---- Caches / tokens --------------------------------------------------------
# HF_HOME defaults to ~/.cache/huggingface on each node; override only if needed.
# HF_HOME=/data/hf
# WORKER_HF_HOME=/data/hf
HF_REVISION=
HF_TOKEN=

# ---- Free-form overrides ----------------------------------------------------
# Appended last to the sglang args (argparse last-wins → overrides anything
# above). Example YaRN scaling for >262k context (see .env for the v2 recipe):
# EXTRA_ARGS=--context-length 900000 --max-prefill-tokens 2048 --json-model-override-args {"text_config":{"rope_scaling":{"rope_type":"yarn","factor":4.0,"original_max_position_embeddings":262144},"max_position_embeddings":1048576}}
EXTRA_ARGS=
