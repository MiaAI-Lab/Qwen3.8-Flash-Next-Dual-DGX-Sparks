# tp1/offload.env — ONE DGX Spark, SAFE fallback: same FP8-dense+MTP+NVFP4-PLE
# checkpoint, but the 26.8 GiB PLE table is memory-mapped in the CPU offload worker
# (the 2026-09-04 known-good mechanism), so ~72 GiB sits on the GPU and KV has room.
# Slower per step than resident (host-side PLE handshake) but no UVM cliff.
#   ./start-tp1.sh --profile tp1/offload.env
TP1_MODEL_ID="MiaAI-Lab/Qwen3.8-Flash-Next-NVFP4-FP8dense-MTP-PLE4"
TP1_PLE_OFFLOAD=true
TP1_FP8_DENSE=true
TP1_MTP_NUM_SPECULATIVE_TOKENS=3
TP1_MTP_DRAFT_VOCAB="/home/sparky/Qwen3.8-Flash-Next-Dual-DGX-Sparks/draft_vocab_32k.txt"
TP1_KV_CACHE_DTYPE=fp8
TP1_MAX_MODEL_LEN=262144
TP1_MAX_NUM_SEQS=8
TP1_MAX_NUM_BATCHED_TOKENS=2048
TP1_KV_TARGET_GIB=20
TP1_HOST_SLACK_GIB=5
TP1_LANGUAGE_MODEL_ONLY=true
TP1_SKIP_MM_PROFILING=true
