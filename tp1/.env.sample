# tp1/.env — single-Spark (TP=1) deployment. Copy to .env and edit.
IMAGE="vllm/vllm-openai:qwen38-flash-next"
SERVED_MODEL_NAME="qwen3.8-flash-next"
# HF_TOKEN=""                       # only needed if the checkpoint is gated

# Known-good serving profile (2026-09-04). Every value can be overridden
# from the environment: MAX_MODEL_LEN=65536 ./start.sh
MAX_MODEL_LEN=262144                # native rope max; YaRN is not offered at TP1
MTP_NUM_SPECULATIVE_TOKENS=3        # 0 disables MTP (saves 1.5 GiB)
KV_TARGET_GIB=20                    # ~686k tokens of KV; leaves ~13 GiB host MemAvailable
HOST_SLACK_GIB=5                    # container cgroup cap = GPU budget + this
PORT=8888
