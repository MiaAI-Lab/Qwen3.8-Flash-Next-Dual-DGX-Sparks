# tp1/resident.env — ONE DGX Spark, whole checkpoint RESIDENT on the GPU.
#   ./start-tp1.sh --profile tp1/resident.env
# Checkpoint: FP8-dense + quantized MTP (files/fp8dense) with the PLE n-gram table
# requantized FP8 -> NVFP4 (files/ple_nvfp4/build.sh): 98.7 GiB of tensors.
# Every value here is a TP1_* knob of start-tp1.sh; caller env (e.g. MAX_NUM_SEQS=8)
# still wins. The 2-node .env values (FP8_DENSE, EXTRA_VLLM_ARGS, ...) never leak in.
#
# Memory (121.69 GiB unified): 98.7 weights + 5.6 runtime + 1.49 MTP + KV target
# => GMU ~0.87-0.92. vLLM refuses to start if free device memory < GMU x total, so
# the 2-node server must be stopped and page cache should be dropped first.
# REQUIRES the VM tunables from docs/HANDOFF-single-spark.md §6 (host hung once
# loading ~99 GiB through UVM with defaults):
#   sudo sysctl -w vm.min_free_kbytes=4194304 vm.watermark_scale_factor=300 vm.swappiness=30 vm.vfs_cache_pressure=200
#   sudo sysctl -w vm.drop_caches=3
TP1_MODEL_ID="MiaAI-Lab/Qwen3.8-Flash-Next-NVFP4-FP8dense-MTP-PLE4"
TP1_PLE_OFFLOAD=false               # resident NVFP4 PLE table (no offload worker, no handshake)
TP1_FP8_DENSE=true                  # FP8-dense loader overlay (needed for this checkpoint)
TP1_MTP_NUM_SPECULATIVE_TOKENS=3
TP1_MTP_DRAFT_VOCAB="/home/sparky/Qwen3.8-Flash-Next-Dual-DGX-Sparks/draft_vocab_32k.txt"
TP1_KV_CACHE_DTYPE=fp8              # halves K/V blocks (indexer caches stay bf16 by design)
TP1_MAX_MODEL_LEN=65536             # raise once the measured KV headroom is known
TP1_MAX_NUM_SEQS=8
TP1_MAX_NUM_BATCHED_TOKENS=2048     # the 5.6 GiB overhead was measured at 2048; 8192 costs activations
TP1_KV_TARGET_GIB=4                 # ~290k fp8 tokens; derived GMU ~0.89 = 108 GiB requested.
                                    # HANDOFF §4 proved GMU 0.872 (106 GiB) loads a 98.66 GiB checkpoint
                                    # with 3.05 GiB KV left; vLLM refuses GMU x 121.69 > free device memory,
                                    # so if startup fails on that check pin GPU_MEMORY_UTILIZATION=0.87.
TP1_MTP_GIB=0.5                     # MTP weights are inside the 98.7 GiB; this covers the draft-head slice+KV
TP1_LANGUAGE_MODEL_ONLY=true        # skip the 0.84 GiB vision tower (text-only API)
TP1_SKIP_MM_PROFILING=true
TP1_CONTAINER_MEM_GIB=40            # host-side cap only: GPU params are not cgroup-charged on GB10
TP1_MEMWATCH_MIN_GIB=4
# VLLM_MTP_DRAFT_VOCAB_BALANCE is intentionally absent: a no-op at TP=1.
# TP1_VLLM_EXTRA_ENV="VLLM_TEST_FORCE_FP8_MARLIN=1"   # untested with FP8-dense (RESULTS.md); leave off
