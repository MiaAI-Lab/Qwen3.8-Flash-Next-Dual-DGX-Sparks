.last_tp1_launch.sh

# Extracted verbatim from the vLLM image by start.sh, then patched in place.
# Both sides are regenerated on every launch; the generators in files/patch_*.py
# are the source of truth.
*.orig
files/mtp_patched.py
files/modelopt_patched.py
files/qsa_ops_patched.py
files/qsa_nvidia_patched.py
files/overlay/*.py
files/qsa_gb10/qsa.py

# Draft vocabularies are built from a corpus (files/build_draft_vocab.py);
# see README "Reduced-vocabulary MTP drafting".
files/draft_vocab_*.txt
# ...except the shipped code-tuned vocabulary (47,149 ids), which makes the
# MTP_DRAFT_VOCAB default in .env.sample work out of the box. Generated
# vocabularies stay untracked.
!files/draft_vocab_en_code_47k.txt
